rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Existing collections ──────────────────────────────────────────────────
    // DO NOT change these — checkout and track-order depend on them.

    match /orders/{orderId} {
      allow create: if true;                        // checkout creates orders client-side
      allow get:    if true;                        // track-order reads a single order
      allow list, update, delete: if request.auth != null;
    }

    match /catalog/{docId} {
      allow read:  if true;                         // storefront reads catalogue
      allow write: if request.auth != null;
    }

    match /settings/{docId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── Follow-up system ─────────────────────────────────────────────────────
    // All customer-facing reads/writes go through server-side Vercel functions
    // using the Firebase Admin SDK (which bypasses these rules entirely).
    // These rules grant the admin dashboard client-side access via Firebase Auth,
    // and deny all anonymous / unauthenticated browser access.

    match /followUps/{docId} {
      allow read, write: if request.auth != null;
    }

    match /products/{docId} {
      allow read, write: if request.auth != null;
    }

    match /reviews/{docId} {
      allow read, write: if request.auth != null;
    }

    match /promoCodes/{docId} {
      allow read, write: if request.auth != null;
    }

    match /events/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
