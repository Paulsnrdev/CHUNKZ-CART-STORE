# ──────────────────────────────────────────────────────────────────────────────
# Chunkz Follow-Up System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. All secrets must be added to Vercel project settings.
# ──────────────────────────────────────────────────────────────────────────────

# ── Firebase Admin SDK (server-side only) ─────────────────────────────────────
# Generate in Firebase Console → Project Settings → Service accounts → Generate new private key
# Copy the three fields below from the downloaded JSON file.
FIREBASE_PROJECT_ID=chunkz-store
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@chunkz-store.iam.gserviceaccount.com
# Paste the privateKey value exactly as it appears in the JSON (including \n escape sequences).
# In Vercel dashboard, paste it as-is; the sdk init code restores the real newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANB...\n-----END PRIVATE KEY-----\n"

# ── Paystack keys ─────────────────────────────────────────────────────────────
# Get from Paystack Dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# ── Resend (Phase 4 — transactional email) ────────────────────────────────────
# Create an account at resend.com, verify your chunkzthebrand.com domain, then
# generate an API key. Set EMAIL_FROM to your verified sending address.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Chunkz <hello@chunkzthebrand.com>

# ── Site URL (Phase 4 — used to build /follow-up/<token> links in emails) ─────
SITE_URL=https://chunkzthebrand.com

# ── Dry-run mode (Phase 4) ────────────────────────────────────────────────────
# Set to true during testing. Emails are logged to console instead of sent.
DRY_RUN=false

# ── Anthropic Claude API (Phase 5 — upsell recommendation fallback) ───────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Promo code defaults (Phase 6) ─────────────────────────────────────────────
PROMO_DISCOUNT_PERCENT=15
PROMO_EXPIRY_HOURS=72
